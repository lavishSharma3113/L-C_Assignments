import java.util.*;

public class Main {

    private static final Map<String, List<String>> COUNTRY_MAP = createCountryMap();

    public static void main(String[] args) {
        getCountryCode();
    }
    
    private static void getCountryCode() {
         Scanner inputScanner = new Scanner(System.in);
        printWelcomeMessage();
        int choice=1;
        while (choice == 1) {
            String countryCode = getInputCountryCode(inputScanner);
            printAdjacentCountries(countryCode);
            System.out.println("Do You want to continue? Press 1 to continue or any key  to exit");
            try{
            choice = inputScanner.nextInt();
            inputScanner.nextLine();
            if(choice != 1){
                break;
            }
            } catch(Exception e){break;}
        }

        inputScanner.close();
        printExitMessage();
    }

    private static Map<String, List<String>> createCountryMap() {
        Map<String, List<String>> countryMap = new HashMap<>();
        countryMap.put("IN", Arrays.asList("Pakistan", "China", "Nepal", "Bangladesh", "Bhutan", "Myanmar"));
        countryMap.put("US", Arrays.asList("Canada", "Mexico"));
        countryMap.put("NZ", Collections.singletonList("No adjacent countries"));
        countryMap.put("AU", Collections.singletonList("No adjacent countries"));
        countryMap.put("BR", Arrays.asList("Argentina", "Uruguay", "Paraguay", "Bolivia", "Peru", "Colombia", "Venezuela", "Guyana", "Suriname"));
        return countryMap;
    }

    private static void printWelcomeMessage() {
        System.out.println("Welcome to the Adjacent Countries Finder!\n");
        System.out.println("Type a country code (e.g., IN, US, NZ) to find its adjacent countries.");
    }

    private static String getInputCountryCode(Scanner scanner) {
        System.out.print("\nEnter the country code: ");
        return scanner.nextLine().toUpperCase().trim();
    }


    private static void printExitMessage() {
        System.out.println("Exiting the program. Goodbye!");
    }

    private static void printAdjacentCountries(String countryCode) {
        if (COUNTRY_MAP.containsKey(countryCode)) {
            System.out.println("\nAdjacent countries for " + countryCode + ":");
            List<String> adjacentCountries = COUNTRY_MAP.get(countryCode);
            adjacentCountries.forEach(country -> System.out.println("- " + country));
        } else {
            System.out.println("\nCountry code not recognized. Please try again.");
        }
    }
}
