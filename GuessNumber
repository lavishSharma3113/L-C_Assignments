import random
def isNumberInRange(inputNumber):
    if inputNumber.isdigit() and 1<= int(inputNumber) <=100:
        return True
    else:
        return False

def guessNumber():
    randomNumber=random.randint(1,100)
    isGuessed=False
    inputNumber=takeInput("Guess a number between 1 and 100:")
    totalGuesses=0
    while not isGuessed:
        if not isNumberInRange(inputNumber):
            inputNumber=takeInput("I wont count this one Please enter a number between 1 to 100")
            continue
        else:
            totalGuesses+=1
            inputNumber=int(inputNumber)
        
        if(isCorrectGuess(inputNumber,randomNumber)):
            printSuccessMessage(totalGuesses)
            isGuessed=True
        elif isNumberSmall(inputNumber,randomNumber):
             inputNumber=takeInput("Too low. Guess again")
        else:
             inputNumber=takeInput("Too High. Guess again")
        

def isNumberSmall(inputNumber , randomNumber):
    return inputNumber < randomNumber

def takeInput(printMessage):
    return input(printMessage)

def isCorrectGuess(inputNumber,randomNumber):
    if(inputNumber == randomNumber):
        return True
    return False    

def printSuccessMessage(totalGuesses):
    print("You guessed it in",totalGuesses,"guesses!")
    

guessNumber()
